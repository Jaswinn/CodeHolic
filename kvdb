#!/usr/bin/env bash
# POSIX shell wrapper for kvdb
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if command -v python3 >/dev/null 2>&1; then
    exec python3 "$SCRIPT_DIR/kvdb.py" "$@"
elif command -v python >/dev/null 2>&1; then
    exec python "$SCRIPT_DIR/kvdb.py" "$@"
elif [ -f "/c/Program Files/QGIS 4.2.1/apps/Python312/python.exe" ]; then
    exec "/c/Program Files/QGIS 4.2.1/apps/Python312/python.exe" "$SCRIPT_DIR/kvdb.py" "$@"
else
    echo "ERROR: python3 not found" >&2
    exit 1
fi

